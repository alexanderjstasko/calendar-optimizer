# Copy to .env (project root, next to backend/) and fill in. Never commit .env.
# Empty values count as unset. Defaults are noted where the code has one.

# --- Calendars ---------------------------------------------------------------
# Google: put the OAuth client file at backend/google_credentials.json, then run
# `python3 backend/Google_cal_pull.py` once to sign in (writes google_token.json).
# Apple / Outlook / Partiful: the secret iCal (ICS) feed URL of each calendar.
APPLE_ICS_URL=
OUTLOOK_ICS_URL=
PARTIFUL_ICS_URL=

# --- Notion (see README: "Notion databases") --------------------------------
NOTION_TOKEN=
# The Telos tree database (Telos / Goal / Project / Routine / Task rows).
NOTION_GOALS_DB_ID=
# Optional: the scout's Website List database.
NOTION_WEBSITES_DB_ID=
# Optional, legacy: a separate Tasks database, read only while the tree has no Task rows.
NOTION_TASKS_DB_ID=

# --- Claude ------------------------------------------------------------------
# api = Anthropic API key (per-token billing); cli = the `claude` CLI and its login.
LLM_BACKEND=api
ANTHROPIC_API_KEY=
# For LLM_BACKEND=cli on a headless host: `claude setup-token`, paste here.
CLAUDE_CODE_OAUTH_TOKEN=
LLM_MODEL=claude-opus-5
LLM_EFFORT=high
# Fallback home address for travel planning (the Hours tab's address wins).
LLM_HOME_LOCATION=

# --- Network -----------------------------------------------------------------
# The suffix of your Tailscale MagicDNS names (e.g. example-tailnet.ts.net).
# Lets devices on the tailnet use the API (CORS) and the Vite dev server.
TAILNET=
# Where the frontend calls the API in dev; email links use it too.
VITE_API_URL=http://localhost:8000

# --- Job cadence (restart to apply; GET /schedule shows the result) ----------
# DAYS: names (mon,thu), a range (mon-fri), daily or off. TIME: HH:MM, New York.
SYNC_CALENDARS_EVERY_MIN=5
SETTLE_EVERY_MIN=15
NOTION_CHECK_EVERY_MIN=60
CONFLICT_CHECK_EVERY_MIN=5
SCOUT_FETCH_DAYS=mon
SCOUT_FETCH_TIME=06:00
SCOUT_RECOMMEND_DAYS=daily
SCOUT_RECOMMEND_TIME=07:00
OPTIMIZER_RUN_DAYS=sun
OPTIMIZER_RUN_TIME=06:30

# --- Approval emails (NOTIFY_EMAIL_TO unset = no email) ----------------------
# Gmail: smtp.gmail.com, port 587, and an app password (not your account password).
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
# Optional phone push via Pushover.
NOTIFY_PUSHOVER=0
PUSHOVER_USER=
PUSHOVER_TOKEN=

